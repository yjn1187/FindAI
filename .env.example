# FindAI 会自动读取启动目录下的 .env。
# 从其他目录启动时，可以在系统环境变量中设置 FINDAI_ENV_FILE 指向本文件。
FINDAI_HOST=127.0.0.1
FINDAI_PORT=7070
FINDAI_DB_PATH=data/findai.db
FINDAI_SCAN_CIDRS=192.168.1.0/24
FINDAI_SCAN_PORTS=11434,12434,1234,8080,8000-8001,5000,3000,8888,80
FINDAI_SCAN_INTERVAL=300
FINDAI_CONNECT_TIMEOUT=0.35
FINDAI_PROBE_TIMEOUT=2
FINDAI_PROXY_TIMEOUT=300
FINDAI_MAX_CONCURRENCY=256
FINDAI_MAX_HOSTS=1024
FINDAI_MAX_TARGETS=20000
FINDAI_SCAN_ON_STARTUP=true
FINDAI_TLS_VERIFY=false
FINDAI_LOG_PATH=data/logs/findai.log
FINDAI_LOG_LEVEL=INFO
FINDAI_LOG_MAX_BYTES=10485760
FINDAI_LOG_BACKUP_COUNT=5
# FINDAI_GATEWAY_KEY=replace-me
# FINDAI_UPSTREAM_KEYS='{"http://192.168.1.20:8000":"upstream-key"}'
